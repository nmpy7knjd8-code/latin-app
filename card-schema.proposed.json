{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "LatinCard",
 "type": "object",
 "required": [
  "id",
  "type",
  "era",
  "latin",
  "translation",
  "context"
 ],
 "properties": {
  "id": {
   "type": "string"
  },
  "type": {
   "enum": [
    "quote",
    "vocab",
    "grammar",
    "person",
    "artifact",
    "place"
   ]
  },
  "era": {
   "enum": [
    "regal",
    "republic",
    "empire",
    "late_antiquity",
    "early_medieval",
    "high_medieval",
    "late_medieval"
   ]
  },
  "unit": {
   "type": "integer",
   "minimum": 1
  },
  "latin": {
   "type": "string",
   "description": "With macrons (Lewis & Short / Wiktionary headwords). Strip for display only if the user turns macrons off."
  },
  "translation": {
   "type": "string"
  },
  "gloss": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "word": {
      "type": "string"
     },
     "lemma": {
      "type": "string"
     },
     "meaning": {
      "type": "string"
     },
     "parse": {
      "type": "string"
     }
    },
    "required": [
     "word",
     "lemma",
     "meaning"
    ]
   }
  },
  "context": {
   "type": "string",
   "maxLength": 260,
   "description": "Max 40 words (design §6); 260 chars is the enforceable proxy."
  },
  "more": {
   "type": "string"
  },
  "person": {
   "type": "string"
  },
  "source": {
   "type": "object",
   "properties": {
    "work": {
     "type": "string"
    },
    "citation": {
     "type": "string"
    },
    "date": {
     "type": "string"
    }
   },
   "required": [
    "work",
    "citation"
   ]
  },
  "attribution_confidence": {
   "enum": [
    "verified",
    "traditional",
    "apocryphal"
   ]
  },
  "attribution_note": {
   "type": "string"
  },
  "theme": {
   "type": "object",
   "properties": {
    "bg": {
     "type": "string"
    },
    "accent": {
     "type": "string"
    }
   }
  },
  "vocab_ids": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "grammar_tags": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "audio": {
   "type": "object",
   "properties": {
    "classical": {
     "type": "string"
    },
    "ecclesiastical": {
     "type": "string"
    }
   }
  },
  "unlock_rule": {
   "type": "object",
   "properties": {
    "min_vocab_known": {
     "type": "number",
     "minimum": 0,
     "maximum": 1,
     "default": 0.7,
     "description": "Fraction known to unlock as a fully glossed preview."
    },
    "review_threshold": {
     "type": "number",
     "minimum": 0,
     "maximum": 1,
     "default": 0.9,
     "description": "Fraction known for plain, unglossed review."
    }
   }
  },
  "image": {
   "$ref": "#/$defs/image"
  },
  "ipa": {
   "type": "string",
   "description": "Restored classical IPA of `latin`, generated by content/phonetics.py (also in content/phonetics.json keyed by id)."
  },
  "respelling": {
   "type": "string",
   "description": "English-reader respelling, stressed syllable in CAPS, e.g. WAY-nee WEE-dee WEE-kee."
  },
  "teaching_value": {
   "type": "object",
   "properties": {
    "note": {
     "type": "string"
    },
    "dcc_core_pct": {
     "type": "number",
     "minimum": 0,
     "maximum": 100
    },
    "non_core": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "score": {
     "type": "integer",
     "minimum": 1,
     "maximum": 5
    },
    "rank": {
     "type": "integer",
     "minimum": 1
    }
   },
   "required": [
    "score"
   ]
  },
  "register": {
   "enum": [
    "classical",
    "ecclesiastical",
    "medieval",
    "medieval-legal"
   ]
  },
  "grammar_preview": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "Grammar seen but not yet taught; glossed, not tested."
  },
  "learn_more": {
   "type": "object",
   "required": [
    "label",
    "url"
   ],
   "properties": {
    "label": {
     "type": "string"
    },
    "url": {
     "type": "string",
     "format": "uri"
    },
    "verified_http": {
     "type": "string"
    }
   }
  },
  "grammar_target": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "Grammar the card's unit has already taught (tested). Build lint: unit >= max taught unit."
  },
  "source_url": {
   "type": "string",
   "format": "uri",
   "description": "Online text the Latin was verified against."
  },
  "subtype": {
   "enum": [
    "vocab",
    "grammar",
    "derivative",
    "inscription",
    "coin",
    "daily_life",
    "mix:map",
    "mix:who_said_it",
    "mix:parse",
    "mix:timeline",
    "mix:listen",
    "mix:true_false",
    "mix:fill_blank"
   ]
  },
  "teaches": {
   "type": "string",
   "maxLength": 200
  },
  "image_idea": {
   "type": "object"
  },
  "dcc_core_pct": {
   "type": [
    "integer",
    "null"
   ],
   "minimum": 0,
   "maximum": 100
  },
  "dcc_ranks": {
   "type": "object"
  }
 },
