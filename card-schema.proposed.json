   "era": "republic",
   "unit": 6,
   "latin": "Vēnī, vīdī, vīcī.",
   "translation": "I came, I saw, I conquered.",
   "context": "After crushing Pharnaces II at Zela (47 BC), Caesar had these three words carried on a placard in his Pontic triumph of 46 BC.",
   "person": "Gaius Julius Caesar",
   "source": {
    "work": "Suetonius, Divus Iulius",
    "citation": "37.2",
    "date": "46 BC (triumph); 47 BC (Zela)"
   },
   "attribution_confidence": "verified",
   "attribution_note": "Suetonius: \"in Pontico triumpho … praetulit titulum VENI·VIDI·VICI.\" Plutarch (Caes. 50) says Caesar wrote the words to his friend Amantius; Plutarch writes in Greek.",
   "gloss": [
    {
     "word": "Vēnī",
     "lemma": "veniō",
     "meaning": "I came",
     "parse": "1st sg. perf. act. ind."
    },
    {
     "word": "vīdī",
     "lemma": "videō",
     "meaning": "I saw",
     "parse": "1st sg. perf. act. ind."
    },
    {
     "word": "vīcī",
     "lemma": "vincō",
     "meaning": "I conquered",
     "parse": "1st sg. perf. act. ind."
    }
   ],
   "grammar_tags": [
    "perfect_tense"
   ],
   "vocab_ids": [
    "venio",
