 "allOf": [
  {
   "if": {
    "properties": {
     "type": {
      "const": "quote"
     }
    }
   },
   "then": {
    "required": [
     "source",
     "person",
     "attribution_confidence",
     "image"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "type": {
      "enum": [
       "person",
       "artifact",
       "place"
      ]
     }
    }
   },
   "then": {
    "required": [
     "image"
    ]
   }
  }
 ],
 "$defs": {
  "image": {
   "type": "object",
