    "src",
    "alt",
    "kind",
    "transparent",
    "license",
    "credit",
    "source_url"
   ],
   "properties": {
    "src": {
     "type": "string"
    },
    "alt": {
     "type": "string"
    },
    "kind": {
     "enum": [
      "statue_cutout",
      "coin",
      "manuscript",
      "building",
      "artifact",
      "inscription",
      "painting"
     ]
    },
    "aspect": {
     "type": "string",
     "description": "e.g. 3:4, 2:3; avoid 1:1"
    },
    "transparent": {
     "type": "boolean"
    },
    "focal_point": {
     "type": "array",
     "items": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "minItems": 2,
     "maxItems": 2
    },
    "credit": {
     "type": "string"
    },
    "license": {
     "enum": [
      "CC0",
      "PDM",
      "PD-art",
      "Public domain",
      "CC BY 4.0",
      "CC BY-SA 4.0",
      "Getty Open Content",
      "CC BY 2.0",
      "CC BY 3.0",
      "CC BY-SA 2.0",
      "CC BY-SA 2.5",
      "CC BY-SA 3.0"
     ]
    },
    "source_url": {
     "type": "string",
     "format": "uri"
    },
    "caption_la": {
     "type": "string",
     "description": "Optional short Latin caption so the image teaches."
    },
    "museum_url": {
     "type": "string",
     "format": "uri",
     "description": "'See in museum' link; defaults to source_url."
    },
    "license_note": {
     "type": "string"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "kind": {
        "enum": [
         "painting",
         "manuscript",
         "inscription"
        ]
       }
      }
     },
     "then": {
      "properties": {
       "transparent": {
        "const": false
       }
      }
     },
     "description": "Cut-outs only for 3D objects."
    }
   ]
  },
  "vocab": {
